{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "git": {
    "deploymentEnabled": {
      "dev": false
    }
  },
  "redirects": [
    {
      "source": "/:path((?!proximamente$|styles\\.css$|favicon\\.|icon-192\\.png$|apple-touch-icon\\.png$|robots\\.txt$).*)",
      "has": [{ "type": "host", "value": "vertidomos.com" }],
      "destination": "/proximamente",
      "permanent": false
    }
  ]
}
