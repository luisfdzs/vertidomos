    { "source": "/es/o-problema", "destination": "/es", "permanent": true },
    { "source": "/es/preguntas-frecuentes", "destination": "/es", "permanent": true },
    { "source": "/es/como-denunciar", "destination": "/es", "permanent": true },
    { "source": "/es/probas", "destination": "/es/evidencias-y-planos", "permanent": true },
